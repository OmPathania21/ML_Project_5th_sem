# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── Secrets & credentials (never commit) ──────────────
.env
.env.*
kaggle.json
*.pem
*.key

# ── Data & models ─────────────────────────────────────
# Raw datasets are small (~18 MB) and need a Kaggle login to download,
# so they ARE committed. Processed data is regenerated by the notebooks.
code/data/processed/*
!code/data/processed/.gitkeep

# Trained model binaries (regenerate by running the notebooks)
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx

# ── Office / editors / OS ─────────────────────────────
# Lock files created while a .pptx/.docx/.xlsx is open
~$*
.~lock.*#

.vscode/
.idea/
*.swp
*~

.DS_Store
._*
Thumbs.db
desktop.ini

# ── Misc ──────────────────────────────────────────────
*.log
node_modules/
